PORT=3000
DATABASE_URL=postgres://tribunal:tribunal@localhost:5432/tribunal
MODEL_ADAPTER=scripted
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADVOCATE_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=openai/gpt-4o
# Judge panel: ethical | evidentiary | analytical | control
# control is an evaluation baseline and is not selectable in the product
JUDGE_PANEL=ethical
# Advocate grounds: grounds (ex ante / ex post) | control
ADVOCATE_SCHEME=grounds
# Strict response schema; unsupported models receive one automatic json_object fallback
STRUCTURED_OUTPUT=json_schema
TEMPERATURE_ADVOCATE=0.8
TEMPERATURE_JUDGE=0.2
MAX_CASE_COST_USD=0.25
# Fallback pricing table, used only when the provider omits usage.cost
ADVOCATE_INPUT_PRICE_PER_MILLION=0.15
ADVOCATE_OUTPUT_PRICE_PER_MILLION=0.60
JUDGE_INPUT_PRICE_PER_MILLION=2.50
JUDGE_OUTPUT_PRICE_PER_MILLION=10.00
GLOBAL_DAILY_BUDGET_USD=5.00
ADVOCATE_TIMEOUT_MS=45000
JUDGE_TIMEOUT_MS=75000
CASE_DEADLINE_MS=360000
MAX_ATTEMPTS_PER_RUN_AUTO=2
MAX_ATTEMPTS_PER_RUN_TOTAL=5
MAX_JOB_ATTEMPTS=3
MAX_INFLIGHT_MODEL_CALLS=4
WORKER_POLL_MS=500
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=
